# Biggie's House — environment variables

# Optional: WebSocket endpoint override for the multiplayer server.
# - Leave unset for local dev (auto-connects to ws://localhost:3001/ws).
# - When served over HTTPS (Cloudflare Worker), the client auto-detects
#   wss://<same-origin>/ws, so this is usually unnecessary.
VITE_WS_URL=

# Cloudflare deployment credentials (used by `wrangler deploy`).
# Get a token at https://dash.cloudflare.com/profile/api-tokens with
# Workers Scripts: Edit, Workers Routes: Edit, Workers Deployments: Edit
# (account scope) and Memberships: Read (user scope).
# `account_id` is already set in wrangler.toml.
CLOUDFLARE_API_TOKEN=
